# Copy to a root/user-only file for CLI use. Never commit the populated file.
MONGODB_URI=mongodb://maintenance-user:replace-me@localhost:27017/example_security?authSource=example_security
ROTATOR_DATABASE=example_security

OLD_FIELD_CRYPTO_PASSPHRASE=
OLD_FIELD_CRYPTO_MASTER_SALT_B64=
NEW_FIELD_CRYPTO_PASSPHRASE=
NEW_FIELD_CRYPTO_MASTER_SALT_B64=

ROTATOR_BATCH_SIZE=100
ROTATOR_MODE=check
ROTATION_RESUME=false

# Required only after changing ROTATOR_MODE to rotate:
APP_MAINTENANCE_CONFIRMED=false
BACKUP_CONFIRMED=false
ROTATION_CONFIRM=
